[Unit]
Description=Lunda future schedule collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lunda-collector/app/lunda_collector
Environment=LUNDA_DB_PATH=/opt/lunda-collector/work/lunda_live/participant_window.sqlite3
ExecStart=/opt/lunda-collector/app/.venv/bin/python -u /opt/lunda-collector/app/lunda_collector/schedule_runner.py --db /opt/lunda-collector/work/lunda_live/participant_window.sqlite3 --device 100.77.174.30:5555 --days 21 --screens 80 --scroll-pixels 880 --cycle-timeout-minutes 90 --launch
TimeoutStartSec=7200
StandardOutput=append:/opt/lunda-collector/work/lunda_schedule_runner.systemd.log
StandardError=append:/opt/lunda-collector/work/lunda_schedule_runner.systemd.log

[Install]
WantedBy=multi-user.target
